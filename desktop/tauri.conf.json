{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Our Free Model",
  "version": "1.0.0",
  "identifier": "io.github.ebony-vinyl.our-free-model",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "resources": {
      "resources/app/": "resources/app/",
      "resources/runtime/": "resources/runtime/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
